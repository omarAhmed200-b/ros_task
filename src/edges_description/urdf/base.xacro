<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="base_length" value="0.7" />
    <xacro:property name="base_width" value="0.5" />
    <xacro:property name="base_height" value="0.3" />
    <xacro:property name="caster_radius" value="0.08" />

    <link name="base_link">
        <inertial>
            <origin xyz="0.08 0 0.17" rpy="0 0 0" />
            <mass value="10" />
            <inertia ixx="0.283333" ixy="0" ixz="0" iyy="0.483333" iyz="0" izz="0.616667" />
        </inertial>
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0" />
            <material name="orange" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0.25" rpy="0 0 0" />
        </collision>
        <collision name="impact_bumper">
            <geometry>
                <box size="0.8 0.6 0.15" />
            </geometry>
            <origin xyz="0 0 0.475" rpy="0 0 0" />
        </collision>
    </link>

    <link name="front_caster">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.5" />
            <inertia ixx="0.00128" ixy="0" ixz="0" iyy="0.00128" iyz="0" izz="0.00128" />
        </inertial>
        <visual>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="gray" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
    </link>

    <joint name="front_caster_joint" type="fixed">
        <origin xyz="0.25 0 ${caster_radius}" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="front_caster" />
    </joint>

    <gazebo reference="front_caster">
        <mu1>0.05</mu1>
        <mu2>0.05</mu2>
    </gazebo>
</robot>
